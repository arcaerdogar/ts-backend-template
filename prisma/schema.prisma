generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  // Sosyal girişle (Google) oluşan kullanıcının şifresi olmaz -> nullable.
  passwordHash      String?
  emailVerified     Boolean   @default(false)
  isSuspended       Boolean   @default(false)
  failedLoginCount  Int       @default(0)
  lockUntil         DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  files                 File[]
  roles                 HasRole[]
  profile               Profile?
  oauthAccounts         OAuthAccount[]
  fcmTokens             FcmToken[]
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  APPLE
}

// Bir kullanıcının bir OAuth sağlayıcısındaki kimliği. Eşleştirme anahtarı her
// zaman providerAccountId'dir (= id_token.sub), email DEĞİL. Sağlayıcının
// access/refresh token'ları KASITLI olarak saklanmaz (bkz. güvenlik notları).
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String // = id_token.sub, EMAIL DEĞİL
  email             String? // bilgi amaçlı, eşleştirme anahtarı değil
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Her kullanıcı için zorunlu 1:1 profil. "Bir profil tek bir user'a ait + user
// başına tek profil" DB tarafından garanti edilir (userId UNIQUE + NOT NULL +
// FK). "Her user'ın profili olmalı" tarafı register'da User+Profile'ın tek
// transaction'da (nested create) oluşturulmasıyla sağlanır.
model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String
  lastName    String
  photoFileId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoFile File? @relation(fields: [photoFileId], references: [id])
}

enum RoleName {
  SYSTEM_ADMIN
}

model HasRole {
  id     String   @id @default(uuid())
  userId String
  role   RoleName

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// Append-only auth/güvenlik denetim kaydı. Oturum durumu Redis'tedir;
// bu tablo yalnızca sorgulanabilir GEÇMİŞ içindir (bkz. ADR 0001).
// Kasıtlı olarak User'a hard FK yoktur: kullanıcı silinse de geçmiş kalır.
enum AuthEventType {
  LOGIN
  LOGOUT
  LOGOUT_ALL
  ADMIN_REVOKE
  PASSWORD_REVOKE
  REUSE_DETECTED
  ACCOUNT_DELETED

  LOGIN_FAILED
  LOGIN_BLOCKED_LOCKED
  LOGIN_BLOCKED_SUSPENDED
  ACCOUNT_LOCKED
  ACCOUNT_SUSPENDED
  ACCOUNT_UNSUSPENDED

  TWO_FA_ISSUED
  TWO_FA_VERIFIED
  TWO_FA_FAILED

  OAUTH_LOGIN
  OAUTH_REGISTER
  OAUTH_LINKED
  OAUTH_STATE_MISMATCH
}

model AuthEvent {
  id        String        @id @default(uuid())
  userId    String?
  email     String?
  type      AuthEventType
  jti       String?
  deviceId  String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([email, createdAt])
}

// Bir cihaza push bildirimi göndermek için kullanılan FCM (Firebase Cloud
// Messaging) kayıt token'ı. Kullanıcı başına + cihaz başına tek kayıt tutulur
// (userId+deviceId UNIQUE); yeni token gelince aynı satır güncellenir. Geçersiz
// token'lar (FCM "not-registered" dönerse) isActive=false yapılır, silinmez.
enum FcmPlatform {
  WEB
  IOS
  ANDROID
}

model FcmToken {
  id         String      @id @default(uuid())
  userId     String
  token      String      @unique
  deviceId   String
  platform   FcmPlatform
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
}

enum FilePurpose {
  PROFILE_PHOTO
  POST_ATTACHMENT
  DOCUMENT
  OTHER
  TEST_FILE
}

model File {
  id        String      @id @default(uuid())
  purpose   FilePurpose
  key       String      @unique
  bucket    String
  name      String
  mimeType  String
  size      Int
  checksum  String
  isPublic  Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  userId    String?
  // Kullanıcı hard-delete edilince dosyalar silinmez, öksüz kalır (SetNull).
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Bu dosya bir profil fotoğrafı olarak kullanılıyorsa (1:1).
  profile   Profile?
}