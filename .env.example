# Bu dosyayı .env olarak kopyala ve değerleri doldur:
#   cp .env.example .env
# Zorunlu değişkenler eksikse uygulama boot sırasında "Missing env: X" ile durur
# (bkz. src/config/env.ts). Yorumlu olanlar opsiyoneldir.

PORT=3000
# NODE_ENV=production            # production'da COOKIE_SECURE otomatik true olur

# Logging: debug | info | warn | error | silent (varsayılan info)
LOG_LEVEL=info

# CORS — virgülle ayrılmış izinli origin listesi
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ---- Database (PostgreSQL) --------------------------------------------------
# Aşağıdaki değer HOST tarafında geliştirme (npm run dev) içindir -> host "localhost".
# docker-compose ile çalıştırırken app, compose ağındaki "postgres" servisine
# otomatik bağlanır (compose bu değeri ezer) — burada bir şey değiştirmene gerek yok.
DATABASE_URL="postgresql://appuser:appsecret@localhost:5432/appdb"
#
# ⚠️ CLOUD / MANAGED POSTGRES (RDS, Neon, Supabase, ...) KULLANACAKSAN:
#   1) Yukarıdaki DATABASE_URL'i bulut bağlantı string'inle değiştir.
#   2) docker-compose.yml'de app servisindeki "DATABASE_URL" override satırını SİL
#      (böylece buradaki bulut değeri kullanılır).
#   3) Yerel "postgres" servisi ARTIK GEREKSİZ -> durdur/kaldır:
#        docker compose stop postgres     (veya compose'daki postgres bloğunu yorumla)
#   (Redis yine gereklidir: oturumlar orada yaşıyor.)

# Bundled postgres servisinin oluşturacağı kullanıcı/parola/veritabanı.
# DATABASE_URL ile TUTARLI olmalı. Cloud DB kullanıyorsan bunlar kullanılmaz.
POSTGRES_USER="appuser"
POSTGRES_PASSWORD="appsecret"
POSTGRES_DB="appdb"

# ---- Auth -------------------------------------------------------------------
JWT_SECRET="complex-secret"
JWT_ACCESS_EXPIRES_MIN=15
JWT_TWO_FACTOR_EXPIRES_MIN=10
JWT_TWO_FACTOR_SECRET="another-complex-secret"
JWT_ROOT_EXPIRES_MIN=60                    # Opsiyonel (varsayılan 60). Root admin token ömrü.
REFRESH_EXPIRES_DAYS=30
REFRESH_TOKEN_HASH_SECRET="another-long-random-secret"

# ---- Root Admin Panel -------------------------------------------------------
ADMIN_EMAIL="root@myapp.com"
ADMIN_PASSWORD="strong-root-password"
ROOT_ACCESS_COOKIE_NAME="root_access"      # Opsiyonel
COOKIE_SECURE=false                        # Opsiyonel (production'da otomatik true)

# ---- AWS --------------------------------------------------------------------
AWS_REGION="eu-north-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."

# S3
S3_BUCKET_NAME="my-app-files"
CDN_DOMAIN=""                              # Opsiyonel (örn. cdn.myapp.com)

# SES
SES_SENDER_EMAIL="noreply@myapp.com"

# ---- Redis (rate limiting, 2FA denylist, sessions, BullMQ) ------------------
# Host dev: compose bir redis'i localhost:6379'da yayınlar.
# docker-compose içinde app otomatik olarak redis://redis:6379'a bağlanır.
REDIS_URL="redis://localhost:6379"

# ---- Google OAuth / OIDC (opsiyonel — "Sign in with Google") ----------------
# App-driven native flow (RFC 8252); bkz. ADR 0002. Rotalar YALNIZCA
# CLIENT_ID + REDIRECT_URI birlikte set edildiğinde mount edilir. Public native
# client'ta client_secret YOKTUR (opsiyonel; sadece confidential/web client için).
# REDIRECT_URI, app'in App Link / Universal Link adresidir (exchange'de echo'lanır).
GOOGLE_CLIENT_ID=""
GOOGLE_REDIRECT_URI="https://app.myapp.com/oauth/callback"
# GOOGLE_CLIENT_SECRET=""                  # opsiyonel; sadece confidential client
# OAUTH_ATTESTATION_ENABLED=false          # true iken /auth/oauth/google geçerli bir
#                                          # app attestation ister (verifier'ı
#                                          # setAppAttestationVerifier ile bağla — ADR 0002)

# ---- Firebase Cloud Messaging / Push (opsiyonel) ----------------------------
# Ayarlanmazsa push gönderimleri sessizce no-op olur; token kayıt endpoint'i
# çalışır ama gerçek gönderim yapılmaz. İki yoldan biri:
#  (A) Service account JSON dosya yolu:
# FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/firebase-service-account.json"
#  (B) Ya da üç alanı ayrı ayrı (private key'de gerçek satır sonları \n olarak):
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
