# Test ortamı. docker-compose.test.yml ile uyumlu (port 5433 / 6380).
# AWS kimlik bilgileri sahte; SES testlerde aws-sdk-client-mock ile mock'lanır.
PORT=3001
NODE_ENV=test
LOG_LEVEL=silent

ALLOWED_ORIGINS="http://localhost:5173"

DATABASE_URL="postgresql://test:test@localhost:5433/test_db"

JWT_SECRET="test-jwt-secret"
JWT_ACCESS_EXPIRES_MIN=15
JWT_TWO_FACTOR_EXPIRES_MIN=10
JWT_TWO_FACTOR_SECRET="test-2fa-secret"
JWT_ROOT_EXPIRES_MIN=60
REFRESH_EXPIRES_DAYS=30
REFRESH_TOKEN_HASH_SECRET="test-refresh-hmac-secret"

AWS_REGION="eu-north-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

SES_SENDER_EMAIL="noreply@test.local"

S3_BUCKET_NAME="test-bucket"

REDIS_URL="redis://localhost:6381"

ADMIN_EMAIL="root@test.local"
ADMIN_PASSWORD="root-test-password"

COOKIE_SECURE=false

# Google OAuth (test). Public native client: client_id + redirect_uri yeterli,
# client_secret YOK (bu yüzden verilmedi) -> /auth/oauth/* rotaları yine mount
# olur. Testlerde Google JWKS + token endpoint mock'lanır (dış ağ yok).
# redirect_uri, app'in App Link / Universal Link adresidir (exchange'de echo'lanır).
GOOGLE_CLIENT_ID="test-google-client-id"
GOOGLE_REDIRECT_URI="https://app.test.local/oauth/callback"
